    "xlo = 10 ** (np.log10(all_x.min()) - log_pad)\n",
    "xhi = 10 ** (np.log10(all_x.max()) + log_pad)\n",
    "ax.set_xlim(xlo, xhi)\n",
    "style_log_x(ax, xlo, xhi)\n",
    "\n",
    "ax.set_xlabel(\"S/N\")\n",
    "ax.set_ylabel(r\"$R^{\\rm PSF}$\")\n",
