    "# Metacal shear response R11/R22 with a jackknife error bar on the ensemble mean\n",
    "# (the same <R> the m-bias jackknife divides by). Error bars added per request.\n",
    "def _jack_err(arr, njac=30):\n",
    "    \"\"\"Jackknife error on the ensemble mean of a per-object response array.\"\"\"\n",
    "    a = np.asarray(arr, float); a = a[np.isfinite(a)]\n",
    "    n = a.size\n",
    "    if n < max(njac, 2):\n",
    "        return np.nan\n",
    "    chunks = np.array_split(np.arange(n), njac)\n",
    "    ms = np.empty(njac)\n",
    "    for k, ch in enumerate(chunks):\n",
    "        mask = np.ones(n, bool); mask[ch] = False\n",
    "        ms[k] = a[mask].mean()\n",
    "    return np.sqrt((njac - 1) * np.mean((ms - ms.mean()) ** 2))\n",
    "\n",
    "panels = [('ngmix R11', R11_, R22_, COLORS['ngmix'], HAS_R22)]\n",
    "if HAS_SN:\n",
    "    has_r22_sn = not np.all(np.isnan(R22_SN_))\n",
    "    panels.append(('ShearNet R11', R11_SN_, R22_SN_, COLORS['shearnet'], has_r22_sn))\n",
    "\n",
    "fig, axes = plt.subplots(1, len(panels), figsize=(5 * len(panels), 4))\n",
    "if len(panels) == 1:\n",
    "    axes = [axes]\n",
    "\n",
    "for ax, (title, r11_arr, r22_arr, cols, has_r22) in zip(axes, panels):\n",
    "    vr = np.isfinite(r11_arr)\n",
    "    m11, e11 = np.nanmean(r11_arr), _jack_err(r11_arr)\n",
    "    ax.hist(r11_arr[vr], bins=60, color=cols[0], alpha=0.7, label=r'$R_{11}$')\n",
    "    ax.axvline(m11, color=cols[0], ls='--', lw=1.8,\n",
    "               label=rf'$\\langle R_{{11}} \\rangle = {m11:.3f} \\pm {e11:.3f}$')\n",
    "    ax.axvspan(m11 - e11, m11 + e11, color=cols[0], alpha=0.25)\n",
    "    ax.errorbar([m11], [0.92], xerr=[e11], transform=ax.get_xaxis_transform(),\n",
    "                fmt='o', color=cols[0], capsize=4, ms=5, zorder=5)\n",
    "    if has_r22:\n",
    "        vr2 = np.isfinite(r22_arr)\n",
    "        m22, e22 = np.nanmean(r22_arr), _jack_err(r22_arr)\n",
    "        ax.hist(r22_arr[vr2], bins=60, color=cols[1], alpha=0.7, label=r'$R_{22}$')\n",
    "        ax.axvline(m22, color=cols[1], ls='-.', lw=1.8,\n",
    "                   label=rf'$\\langle R_{{22}} \\rangle = {m22:.3f} \\pm {e22:.3f}$')\n",
    "        ax.errorbar([m22], [0.84], xerr=[e22], transform=ax.get_xaxis_transform(),\n",
    "                    fmt='s', color=cols[1], capsize=4, ms=5, zorder=5)\n",
    "    ax.set_xlabel('Response'); ax.set_ylabel('Count'); ax.set_title(title)\n",
    "    ax.legend(fontsize=9)\n",
    "\n",
    "plt.suptitle('Metacal Response Diagnostics', fontsize=14)\n",
    "plt.tight_layout()\n",
    "\n",
    "print(f'ngmix   : <R11> = {np.nanmean(R11_):.4f} +/- {_jack_err(R11_):.4f}')\n",
    "if HAS_SN:\n",
    "    print(f'ShearNet: <R11> = {np.nanmean(R11_SN_):.4f} +/- {_jack_err(R11_SN_):.4f}')\n",
    "plt.savefig(os.path.join(METACAL_DIR, \"r11_response.png\"), dpi=150, bbox_inches=\"tight\")\n",
    "print(f\"Saved -> {os.path.join(METACAL_DIR, 'r11_response.png')}\")"
